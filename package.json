{
  "name": "mixer-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:docs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "verify:pack:bun": "node scripts/verify-pack.mjs --runtime=bun",
    "verify:pack:workers": "node scripts/verify-pack.mjs --runtime=workers"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@cloudflare/workers-types": "^5.20261125.1",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
