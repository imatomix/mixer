{
  "name": "mixer-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "node scripts/run-in-scope.mjs test",
    "typecheck": "node scripts/run-in-scope.mjs typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "verify:pack:bun": "node scripts/verify-pack.mjs --runtime=bun"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "vitest": "catalog:",
    "typescript": "catalog:"
  }
}
