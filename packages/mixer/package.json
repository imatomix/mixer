{
  "name": "@imatomix/mixer",
  "version": "0.2.0",
  "description": "Minimal & asynchronous web module",
  "type": "module",
  "exports": {
    ".": {
      "@imatomix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "@imatomix/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "mixer",
    "web",
    "http",
    "mix"
  ],
  "author": "Keita Imatomi",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imatomix/mixer.git",
    "directory": "packages/mixer"
  },
  "homepage": "https://github.com/imatomix/mixer/tree/main/packages/mixer#readme",
  "bugs": {
    "url": "https://github.com/imatomix/mixer/issues"
  }
}
