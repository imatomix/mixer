{
  "name": "@imatomix/mix-session",
  "version": "0.2.0",
  "description": "Server-side sessions for mixer",
  "type": "module",
  "exports": {
    ".": {
      "@imatomix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "@imatomix/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./redis": {
      "@imatomix/source": "./src/redis.ts",
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "mixer",
    "session",
    "cookie",
    "mix"
  ],
  "author": "Keita Imatomi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imatomix/mixer.git",
    "directory": "packages/mix-session"
  },
  "homepage": "https://github.com/imatomix/mixer/tree/main/packages/mix-session#readme",
  "bugs": {
    "url": "https://github.com/imatomix/mixer/issues"
  },
  "peerDependencies": {
    "@imatomix/mixer": "^0.2.0"
  },
  "devDependencies": {
    "@imatomix/mixer": "workspace:*",
    "@types/node": "catalog:",
    "redis": "^6.3.1",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
